# ---------------------------------------------
# PRODUCTION — Namecheap cPanel (server356.web-hosting.com)
# ---------------------------------------------
# Copiez ce fichier vers .env sur le serveur et remplissez les valeurs

# ---------------------------------------------
# Base de données MySQL (cPanel)
# ---------------------------------------------
# Format: mysql://UTILISATEUR:MOT_DE_PASSE@HOST:PORT/DATABASE
# ⚠️ Les caractères spéciaux dans le mot de passe doivent être URL-encodés
#    Ex: ! → %21, @ → %40, # → %23, $ → %24, % → %25, ^ → %5E, & → %26, * → %2A
# ⚠️ Le mot de passe MySQL doit être "CentreLoudaya2026" (identique à ADMIN_PASSWORD)
DATABASE_URL="mysql://UTILISATEUR_CPANEL:CentreLoudaya2026@localhost:3306/centxfci_salon"

# ---------------------------------------------
# Serveur Node.js
# ---------------------------------------------
PORT=5000
NODE_ENV=production

# ---------------------------------------------
# JWT — Secret de signature des tokens (OBLIGATOIRE)
# ---------------------------------------------
# Générer un secret sécurisé : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 caractères, 64 recommandés
JWT_SECRET="REMPLACEZ_PAR_UN_SECRET_ALEATOIRE_64_CARACTERES_MINIMUM"
JWT_EXPIRES_IN="8h"

# ---------------------------------------------
# Compte administrateur (créé par le seed au premier déploiement)
# ---------------------------------------------
# ⚠️ Le mot de passe admin doit être "CentreLoudaya2026" (identique au mot de passe MySQL)
ADMIN_EMAIL="admin@votre-domaine.com"
ADMIN_PASSWORD="CentreLoudaya2026"

# ---------------------------------------------
# CORS : origines autorisées à appeler l'API
# ---------------------------------------------
# En production : VOTRE domaine réel avec HTTPS
# Exemple: CORS_ORIGINS="https://votre-domaine.com,https://www.votre-domaine.com"
CORS_ORIGINS="https://votre-domaine.com"

# ---------------------------------------------
# WhatsApp du salon (numéro local et international)
# ---------------------------------------------
SALON_PHONE="0666923910"
SALON_WHATSAPP="212666923910"