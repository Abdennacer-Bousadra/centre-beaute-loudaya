# ---------------------------------------------
# Base de données MySQL (XAMPP en local)
# ---------------------------------------------
# utilisateur root sans mot de passe, port 3306, base "salon" déjà créée
DATABASE_URL="mysql://root:@localhost:3306/salon"

# ---------------------------------------------
# Serveur
# ---------------------------------------------
PORT=5000
NODE_ENV=development

# Secret de signature des JWT (OBLIGATOIRE, à remplacer en production)
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="changez-moi-par-un-secret-aleatoire-64-caracteres-minimum"
JWT_EXPIRES_IN="8h"

# ---------------------------------------------
# Compte administrateur créé par le seed
# ---------------------------------------------
ADMIN_EMAIL="admin@loudaya.ma"
ADMIN_PASSWORD="CentreLoudaya2026"

# ---------------------------------------------
# CORS : origines autorisées à appeler l'API (séparées par des virgules)
# ---------------------------------------------
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173"

# ---------------------------------------------
# WhatsApp du salon (numéro local et international)
# ---------------------------------------------
SALON_PHONE="0666923910"
SALON_WHATSAPP="212666923910"