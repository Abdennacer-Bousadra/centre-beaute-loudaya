# .htaccess pour cPanel / Passenger (Node.js App)
# Placez ce fichier à la racine du dossier de l'application (document root)

# Désactive le directory listing
Options -Indexes

# Force HTTPS et non-www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]

# Bloque l'accès aux fichiers sensibles
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

<FilesMatch "\.env">
  Order allow,deny
  Deny from all
</FilesMatch>

<FilesMatch "\.(env|log|sql|sqlite|db|bak|backup)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Passenger / Node.js App : redirige toutes les requêtes vers l'app Node
# (cPanel configure automatiquement le proxy vers le port de l'app)
# Si vous avez besoin de règles de réécriture spécifiques, ajoutez-les ici.

# SPA React Router : /services-categories, /booking-section, /pourquoi-nous,
# /ambiance, /contact, /services/massage, etc. doivent renvoyer index.html
# (pas de 404 au chargement direct ou au rafraîchissement).
# Les fichiers et dossiers existants (assets, images, dist, ...) restent servis
# directement. L'API /api n'est jamais réécrite.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api(?:/|$)
RewriteRule ^ index.html [L]

# Headers de sécurité pour les fichiers statiques servis par Apache (si applicable)
<IfModule mod_headers.c>
  # Cache long pour les assets (JS, CSS, images) avec hash dans le nom
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif)$">
    Header set Cache-Control "max-age=31536000, immutable"
  </FilesMatch>

  # Pas de cache pour index.html (SPA routing)
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Protection basique
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Compression gzip pour les fichiers texte
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml
</IfModule>